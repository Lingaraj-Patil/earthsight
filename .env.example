# EarthSight environment configuration
#
# Copy this file to .env.local and fill in the values before running the app.
# .env.local is gitignored and is read server-side only — these values are
# never exposed to the browser.

# REQUIRED for real AI hazard image analysis (Google Gemini vision model).
# Gemini has a genuine FREE tier via Google AI Studio — no credit card,
# no billing account needed for Flash-class models:
#   1. Go to https://aistudio.google.com/apikey
#   2. Click "Create API key" (it can auto-create a Google Cloud project for you)
#   3. Paste the key below
#
# Without this, POST /api/analyze-hazard returns a clear "CONFIG_MISSING"
# error and the report wizard shows that error honestly — it does NOT fall
# back to fake/demo analysis.
GEMINI_API_KEY=

# OPTIONAL — override which Gemini model performs hazard image analysis.
# Defaults to gemini-2.5-flash if not set (a free-tier-eligible model as of 2026).
AI_ANALYSIS_MODEL=gemini-2.5-flash
